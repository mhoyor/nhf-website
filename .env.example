# Copy to .env.local and fill in, or enter these in your host's environment settings.
# PostgreSQL 15 or newer, an empty database is fine: the site sets up its own tables on start.
# The app sets the session time zone to Africa/Lagos.
DATABASE_URL=postgres://nhf:change-me@localhost:5432/nhf
DATABASE_POOL_SIZE=10

# First-time setup: the code asked for on /setup before the first administrator account is made.
# Choose any phrase and keep it private. If empty, the site writes a new code to its log on each
# start, on a line starting "[nhf] No administrator yet".
NHF_SETUP_CODE=

# The site applies db/*.sql on start. Set to "false" to manage the database by hand with psql.
NHF_AUTO_MIGRATE=true

# "true" adds invented clubs, players and results on an empty database, to try the Match
# Centre. Never on the live site.
NHF_DEMO_DATA=false

# Public address of the site, used in links and share text.
SITE_URL=http://localhost:3000

# Set to "true" to show full names of players under 18 on public pages.
# By default they appear as first name and last initial (for example "Ngozi O.").
PUBLIC_FULL_NAMES_UNDER_18=false
